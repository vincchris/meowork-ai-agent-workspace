# --- Meowork env ---
# Qwen (Alibaba Cloud Model Studio, OpenAI-compatible). Get a key at https://bailian.console.aliyun.com/
# Free quota is for dev/test only — treat as ephemeral.
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_DEFAULT_MODEL=qwen-plus

# Optional: any other OpenAI-compatible provider (DeepSeek/Kimi/GLM/Local Ollama)
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=

# Budgets (USD)
DAILY_BUDGET_USD=1.00
MONTHLY_BUDGET_USD=10.00
PER_TASK_BUDGET_USD=0.25
